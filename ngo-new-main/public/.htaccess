Options -Indexes

# ── Browser caching – static assets ────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # CSS / JS / JSX (versioned by filename changes)
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  # Images
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/gif                 "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  # Fonts
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  # HTML – short cache so updates land quickly
  ExpiresByType text/html                 "access plus 1 hour"
</IfModule>

# ── Compression ─────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript text/plain image/svg+xml
</IfModule>

# ── Security headers ────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Cache-Control: immutable for versioned assets served with ?v= or hash in filename
  <FilesMatch "\.(css|js|jsx|png|jpg|jpeg|webp|svg|gif|avif|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML: always revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# ── HTTPS redirect ──────────────────────────────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── www → non-www ──────────────────────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ── Proxy /api/* to Node.js backend on port 5000 ───────────────────
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^api/(.*)$ http://127.0.0.1:5000/api/$1 [P,L]
ProxyPreserveHost On

# ── Clean URLs: serve /about as about.html, etc. ───────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ── 404 fallback → index.html ───────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^ index.html [L]
